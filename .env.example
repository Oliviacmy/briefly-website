# Copy to .env.local for local dev (vercel dev) and set the same values in the
# Vercel dashboard (Project → Settings → Environment Variables) for production.
# Never commit real secrets.

# --- Stripe ---
STRIPE_SECRET_KEY=sk_live_or_test_xxx
STRIPE_MONTHLY_PRICE_ID=price_xxx_monthly
STRIPE_YEARLY_PRICE_ID=price_xxx_yearly
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Optional: override checkout redirect URLs (defaults derive from the request host)
# CHECKOUT_SUCCESS_URL=https://briefly.example/?checkout=success&session_id={CHECKOUT_SESSION_ID}
# CHECKOUT_CANCEL_URL=https://briefly.example/?checkout=cancelled#subscribe

# --- Brevo (Sendinblue) ---
BREVO_API_KEY=xkeysib-xxx
BREVO_LIST_ID=2
BREVO_SENDER_EMAIL=hello@briefly.hk
BREVO_SENDER_NAME=Briefly
